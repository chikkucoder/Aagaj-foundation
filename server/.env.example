# SERVER ENVIRONMENT VARIABLES EXAMPLE

PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/aagaz
JWT_SECRET=your_super_secret_jwt_key_here
FRONTEND_URL=http://localhost:5173

# RAZORPAY CONFIGURATION
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMS GATEWAY CONFIGURATION FOR INDIA
# Choose provider: 'fast2sms' | 'msg91' | 'twilio' (leave blank for DEV MODE console logging)
SMS_PROVIDER=fast2sms

# FAST2SMS (Recommended for India DLT / Quick OTP)
# Obtain API key from: https://www.fast2sms.com/
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE

# MSG91 (Enterprise India SMS)
# Obtain Auth Key from: https://msg91.com/
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY_HERE
MSG91_WIDGET_ID=YOUR_MSG91_WIDGET_ID_HERE
MSG91_TEMPLATE_ID=YOUR_MSG91_OTP_TEMPLATE_ID_HERE

# TWILIO (Global SMS / WhatsApp)
# Obtain SID & Token from: https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
